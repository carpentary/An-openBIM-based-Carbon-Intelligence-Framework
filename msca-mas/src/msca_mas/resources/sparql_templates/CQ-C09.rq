# Semantics: top carbon elements by summed emissions, aligned with
# KnowledgeIndex.top_elements (per-element SUM, DESC order, LIMIT).
PREFIX msca: <http://bimlca.uni.edu/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX qudt: <http://qudt.org/schema/qudt/>

SELECT ?element (SUM(?v) AS ?carbonValue) (MIN(?u) AS ?carbonUnit) WHERE {
  ?wp a msca:ProjectWorkPackage ;
      msca:constructsElement ?element .
  ?resource msca:consumedByWorkPackage ?wp .
  ?emission msca:calculatedFromResource ?resource ;
            msca:belongsToStage ?stage ;
            msca:hasEmissionQuantity ?quantity .
  ?quantity qudt:numericValue ?v ; qudt:unit ?u .
  ?element a ?elementClass .
  ?elementClass rdfs:subClassOf* msca:PhysicalElement .
  FILTER(!BOUND(?stageFilter) || CONTAINS(LCASE(STR(?stage)), LCASE(?stageFilter)))
}
GROUP BY ?element
ORDER BY DESC(?carbonValue)
LIMIT 10
